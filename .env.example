# URL pública do site (usada nas meta tags / Open Graph).
# Na Vercel dá pra deixar em branco: o domínio de produção é detectado sozinho.
NEXT_PUBLIC_SITE_URL=

# Endpoint do formulário de contato (ex.: Formspree — https://formspree.io/f/xxxxxxx).
# Sem isso, o formulário abre o app de e-mail da pessoa com a mensagem pronta.
NEXT_PUBLIC_FORM_ENDPOINT=
